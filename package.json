{
	"name": "jouzu-monorepo",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"workspaces": [
		"packages/*"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"build": "npm run build --workspaces --if-present",
		"check": "npm run check --workspaces --if-present && biome check .",
		"test": "npm run test --workspaces --if-present && npm run test:python",
		"test:python": "uv run --project python/jouzu python -m unittest discover -s python/jouzu/tests -v",
		"pack:check": "node scripts/pack-check.mjs",
		"build:python": "uv build --project python/jouzu --out-dir dist/python",
		"check:python": "uvx --from twine twine check dist/python/*",
		"release:check": "npm run build && npm run check && npm test && npm run pack:check && npm run build:python && npm run check:python",
		"changeset": "changeset",
		"version-packages": "changeset version"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@changesets/cli": "2.31.1",
		"@earendil-works/pi-coding-agent": "0.83.0",
		"@types/node": "24.12.4",
		"typescript": "5.9.3"
	}
}
