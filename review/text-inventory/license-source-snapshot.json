        {
          "number": 40,
          "raw": "## Native TextGuard helper"
        },
        {
          "number": 41,
          "raw": ""
        },
        {
          "number": 42,
          "raw": "`dist/textguard/` contains Linux, Windows, and macOS executables for x64 and"
        },
        {
          "number": 43,
          "raw": "ARM64. `manifest.json` identifies their SHA-256 hashes, source snapshot, Go"
        },
        {
          "number": 44,
          "raw": "toolchain, and scan policy. Build inputs and modifications are recorded in"
        },
        {
          "number": 45,
          "raw": "`upstream/textguard/` in the Jouzu source repository."
        },
        {
          "number": 46,
          "raw": ""
        },
        {
          "number": 47,
          "raw": "`dist/textguard/licenses/` includes the Apache-2.0 TextGuard license, the Go"
        },
        {
          "number": 48,
          "raw": "runtime and golang.org/x/net and golang.org/x/text licenses, the BurntSushi TOML"
        },
        {
          "number": 49,
          "raw": "parser's COPYING file, and Unicode License V3. Embedded confusable and script"
        },
        {
          "number": 50,
          "raw": "data retain Unicode 17.0.0 provenance; generated character classes use Unicode"
        },
        {
          "number": 51,
          "raw": "15.0.0 properties. The helper does not include model-classification runtimes."
        }
      ],
      "qualification": "Bounded declaration/copy/integrity/conditional-display proof only; no full supporting-body closure."
    },
