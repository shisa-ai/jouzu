        {
          "number": 20,
          "raw": "const actualFiles = [\"source\", \"licenses\"].flatMap((part) => list(join(upstream, part), part)).sort();"
        },
        {
          "number": 21,
          "raw": "if (JSON.stringify(actualFiles) !== JSON.stringify(Object.keys(lock.files).sort()))"
        },
