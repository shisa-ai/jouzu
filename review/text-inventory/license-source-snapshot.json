        {
          "number": 60,
          "raw": "## Redistribution"
        },
        {
          "number": 61,
          "raw": ""
        },
        {
          "number": 62,
          "raw": "`licenses/` is copied next to the packaged executables. It includes TextGuard's"
        },
        {
          "number": 63,
          "raw": "Apache-2.0 terms, the Go and golang.org/x dependency licenses, the TOML parser's"
        },
        {
          "number": 64,
          "raw": "COPYING file, and Unicode License V3 from `https://www.unicode.org/license.txt`."
        },
        {
          "number": 65,
          "raw": ""
        },
        {
          "number": 66,
          "raw": "The embedded confusables and script-range JSON retain source URLs, Unicode"
        },
        {
          "number": 67,
          "raw": "17.0.0 identifiers, and input checksums. Generated character classes use Unicode"
        },
        {
          "number": 68,
          "raw": "15.0.0 properties matching Python 3.12. Rule files retain their source comments."
        },
        {
          "number": 69,
          "raw": "The source and vendored dependency trees retain their own license notices."
        }
      ],
      "qualification": "Bounded declaration/copy/integrity/conditional-display proof only; no full supporting-body closure."
