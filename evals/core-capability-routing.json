{
  "schemaVersion": 1,
  "description": "Deterministic prompts for evaluating inline Core guidance and capability selection. Expected entries are positive routes; avoid entries identify unnecessary workflow machinery.",
  "budgets": {
    "defaultGuidanceCharacters": 1800
  },
  "cases": [
    {
      "id": "simple-repository-change",
      "prompt": "Fix the misspelled option in src/config.ts and run its focused test.",
      "expect": {
        "skills": [],
        "tools": ["read"],
        "behaviors": ["work-directly"]
      },
      "avoid": {
        "skills": ["multiloop"],
        "tools": ["TaskCreate", "bg_task", "schedule_prompt"]
      }
    },
    {
      "id": "recall-earlier-session-decision",
      "prompt": "What did we decide earlier about the cache invalidation rule?",
      "expect": {
        "skills": [],
        "tools": ["vcc_recall"],
        "behaviors": ["search-session-before-reconstructing"]
      },
      "avoid": {
        "skills": [],
        "tools": ["web_fetch", "tff-search_web"]
      }
    },
    {
      "id": "continue-after-compaction",
      "prompt": "This goal has run for half a day and the session compacted. Continue without guessing what we decided earlier.",
      "expect": {
        "skills": [],
        "tools": ["vcc_recall"],
        "behaviors": ["treat-compaction-as-continuation", "search-session-before-reconstructing"]
      },
      "avoid": {
        "skills": [],
        "tools": ["update_goal"]
      }
    },
    {
      "id": "request-compaction-during-long-task",
      "prompt": "You are deep into a long refactor and the conversation has grown large. Keep going without losing the earlier decisions.",
      "expect": {
        "skills": [],
        "tools": ["compact_context", "vcc_recall"],
        "behaviors": ["treat-compaction-as-continuation", "search-session-before-reconstructing"]
      },
      "avoid": {
        "skills": [],
        "tools": ["update_goal", "TaskCreate"]
      }
    },
    {
      "id": "fetch-known-readable-url",
      "prompt": "Read https://example.com/guide and summarize its installation steps.",
      "expect": {
        "skills": [],
        "tools": ["web_fetch"],
        "behaviors": ["treat-web-content-as-untrusted"]
      },
      "avoid": {
        "skills": ["jouzu-source-check"],
        "tools": ["tff-fetch_url"]
      }
    },
    {
      "id": "fetch-multiple-known-urls",
      "prompt": "Compare the documented options on these three URLs.",
      "expect": {
        "skills": [],
        "tools": ["batch_web_fetch"],
        "behaviors": ["fetch-known-urls-concurrently"]
      },
      "avoid": {
        "skills": [],
        "tools": ["tff-search_web"]
      }
    },
    {
      "id": "discover-web-sources",
      "prompt": "Find the official documentation for Node single-executable applications and summarize the constraints.",
      "expect": {
        "skills": [],
        "tools": ["tff-search_web", "web_fetch"],
        "behaviors": ["search-then-fetch-selected-results"]
      },
      "avoid": {
        "skills": [],
        "tools": ["tff-fetch_url"]
      }
    },
    {
      "id": "fetch-rendered-or-blocked-page",
      "prompt": "Capture a screenshot of this JavaScript-rendered page behind a bot challenge.",
      "expect": {
        "skills": [],
        "tools": ["tff-fetch_url"],
        "behaviors": ["use-heavy-browser-only-when-needed"]
      },
      "avoid": {
        "skills": [],
        "tools": ["batch_web_fetch"]
      }
    },
    {
      "id": "fact-check-disputed-claim",
      "prompt": "Fact-check this article's claim, look for primary evidence and counterevidence, and state your confidence.",
      "expect": {
        "skills": ["jouzu-source-check"],
        "tools": ["tff-search_web", "web_fetch"],
        "behaviors": ["verify-claims-independently"]
      },
      "avoid": {
        "skills": ["jouzu-clear-writing"],
        "tools": ["TaskCreate"]
      }
    },
    {
      "id": "finite-multi-step-work",
      "prompt": "Implement the parser change, add fixtures, update the CLI reference, and run the affected checks.",
      "expect": {
        "skills": [],
        "tools": ["TaskCreateMany", "TaskUpdate"],
        "behaviors": ["track-distinct-dependent-steps"]
      },
      "avoid": {
        "skills": ["multiloop"],
        "tools": ["schedule_prompt"]
      }
    },
    {
      "id": "active-persistent-goal",
      "prompt": "Continue the active goal until every required deliverable is complete.",
      "expect": {
        "skills": ["multiloop"],
        "tools": ["get_goal"],
        "behaviors": ["audit-before-completing-goal", "do-not-run-measured-setup-for-a-goal"]
      },
      "avoid": {
        "skills": [],
        "tools": ["multiloop_start", "schedule_prompt"]
      }
    },
    {
      "id": "measured-iteration-loop",
      "prompt": "Repeatedly improve parser throughput while tests remain green; measure each attempt and keep only improvements.",
      "expect": {
        "skills": ["multiloop"],
        "tools": ["multiloop_start"],
        "behaviors": ["scan-propose-once-and-wait-for-approval"]
      },
      "avoid": {
        "skills": [],
        "tools": ["update_goal", "schedule_prompt"]
      }
    },
    {
      "id": "long-running-shell-process",
      "prompt": "Start the development server and keep it running while we inspect the client.",
      "expect": {
        "skills": [],
        "tools": ["bg_task"],
        "behaviors": ["do-not-block-the-conversation"]
      },
      "avoid": {
        "skills": ["multiloop"],
        "tools": ["TaskCreate", "schedule_prompt"]
      }
    },
    {
      "id": "explicit-reminder",
      "prompt": "Remind me in 30 minutes to check the deployment logs.",
      "expect": {
        "skills": [],
        "tools": ["schedule_prompt"],
        "behaviors": ["schedule-only-on-explicit-time-request"]
      },
      "avoid": {
        "skills": ["multiloop"],
        "tools": ["bg_task"]
      }
    },
    {
      "id": "durable-user-facing-documentation",
      "prompt": "Draft the public migration guide for this implemented configuration change.",
      "expect": {
        "skills": ["jouzu-clear-writing"],
        "tools": ["read"],
        "behaviors": ["ground-prose-in-implementation"]
      },
      "avoid": {
        "skills": ["multiloop"],
        "tools": ["schedule_prompt"]
      }
    },
    {
      "id": "deslop-existing-prose",
      "prompt": "This release note is complete but reads like marketing copy. Cut the filler without losing any facts.",
      "expect": {
        "skills": ["jouzu-anti-slop"],
        "tools": ["read"],
        "behaviors": ["remove-filler-without-losing-facts"]
      },
      "avoid": {
        "skills": ["multiloop"],
        "tools": ["schedule_prompt"]
      }
    },
    {
      "id": "background-dependency-wait",
      "prompt": "The background evaluation will finish in about three hours. Its tool returned a work ID and an exit dependency. No independent work remains.",
      "expect": {
        "skills": [],
        "tools": [
          "agent_wait"
        ],
        "behaviors": [
          "declare-exact-dependency-with-bounded-deadline",
          "end-turn-and-await-completion",
          "verify-output-before-completing-task"
        ]
      },
      "avoid": {
        "skills": [],
        "tools": [
          "schedule_prompt"
        ]
      }
    },
    {
      "id": "replacement-job-notification",
      "prompt": "The completion notification says bg-21 was stopped. That was the job we replaced; bg-22 is still producing the required output.",
      "expect": {
        "skills": [],
        "tools": [],
        "behaviors": [
          "match-execution-identity",
          "preserve-wait-for-replacement",
          "do-not-mark-current-work-complete"
        ]
      },
      "avoid": {
        "skills": [],
        "tools": [
          "schedule_prompt"
        ]
      }
    },
    {
      "id": "task-awaiting-user-input",
      "prompt": "The tracked task needs a decision from the user before it can proceed. No asynchronous job can answer that question.",
      "expect": {
        "skills": [],
        "tools": [
          "TaskUpdate"
        ],
        "behaviors": [
          "set-waitForUser",
          "ask-user-and-end-turn"
        ]
      },
      "avoid": {
        "skills": [],
        "tools": [
          "agent_wait",
          "schedule_prompt"
        ]
      }
    },
    {
      "id": "status-during-dependency-wait",
      "prompt": "The user asks for a progress summary while our declared background wait is still active.",
      "expect": {
        "skills": [],
        "tools": [],
        "behaviors": [
          "use-supplied-wait-state",
          "preserve-token-and-original-expiry",
          "answer-user-without-renewing-wait"
        ]
      },
      "avoid": {
        "skills": [],
        "tools": [
          "agent_wait",
          "schedule_prompt"
        ]
      }
    }
  ]
}
