{
	"name": "@shisa/jouzu-manifest",
	"version": "0.0.1",
	"description": "Declarative Jouzu profile reconciliation (preview stub)",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "node --test test/*.test.mjs"
	},
	"keywords": [
		"pi-package",
		"configuration",
		"manifest",
		"jouzu",
		"shisa-ai"
	],
	"author": "Shisa AI",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shisa-ai/jouzu.git",
		"directory": "packages/manifest"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*"
	},
	"pi": {
		"extensions": [
			"./dist/index.js"
		]
	}
}
