{
	"name": "jouzu",
	"version": "0.1.6",
	"description": "Agentic AI environment built on the Pi coding agent harness",
	"type": "module",
	"bin": {
		"jouzu": "dist/cli.js",
		"jz": "dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/build-info.json",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"build": "node ../../scripts/install-release-extensions.mjs && node ../../scripts/vendor-clipboard-bindings.mjs && tsc -p tsconfig.json && node ../../scripts/copy-session-ui.mjs && node ../../scripts/prepare-cli.mjs && node ../../scripts/copy-pi-lock.mjs dist/pi.lock.json && node ../../scripts/copy-profiles.mjs && node ../../scripts/copy-catalog.mjs && node ../../scripts/copy-release-extensions.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "node ../../scripts/check-dist-fresh.mjs && node --test test/*.test.mjs"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"coding-agent",
		"pi",
		"japanese",
		"jouzu"
	],
	"author": "Shisa AI",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shisa-ai/jouzu.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/shisa-ai/jouzu#readme",
	"bugs": {
		"url": "https://github.com/shisa-ai/jouzu/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.85.0",
		"@earendil-works/pi-coding-agent": "0.85.0",
		"@earendil-works/pi-server": "0.85.0",
		"@earendil-works/pi-telemetry": "0.85.0",
		"@earendil-works/pi-tui": "0.85.0",
		"@lhl/pi-tasks": "git+https://github.com/lhl/pi-tasks.git#fc2e88bccfe0c5b818daea7092667d75e8e14b3d",
		"@sinclair/typebox": "0.34.52",
		"@sting8k/pi-vcc": "0.7.0",
		"@the-forge-flow/camoufox-pi": "0.2.1",
		"@vanillagreen/pi-background-tasks": "2.0.0",
		"better-sqlite3": "13.0.3",
		"camoufox-js": "0.12.0",
		"esbuild": "0.28.1",
		"impit": "0.11.0",
		"pi-code-previews": "0.1.36",
		"pi-multiloop": "git+https://github.com/lhl/pi-multiloop.git#cffc0e58987249dd16d74f1b554623cd103d10d3",
		"pi-schedule-prompt": "0.4.1",
		"pi-skill-dollar": "git+https://github.com/lhl/pi-skill-dollar.git#4bff5734d87c4f4725d81a4ea1d1c1283c22423c",
		"pi-webaio": "git+https://github.com/shisa-ai/pi-webaio.git#78b56cd784440d31159e0a6b159176f4ba375030",
		"playwright-core": "1.60.0",
		"typebox": "1.3.7",
		"ua-parser-js": "1.0.41"
	},
	"overrides": {
		"@the-forge-flow/camoufox-pi": {
			"camoufox-js": "0.12.0",
			"playwright-core": "1.60.0"
		},
		"camoufox-js": {
			"impit": "0.11.0"
		},
		"ua-parser-js": "1.0.41"
	},
	"bundleDependencies": [
		"@earendil-works/pi-ai",
		"@earendil-works/pi-coding-agent",
		"@earendil-works/pi-telemetry",
		"@earendil-works/pi-tui",
		"@lhl/pi-tasks",
		"@sting8k/pi-vcc",
		"@the-forge-flow/camoufox-pi",
		"@vanillagreen/pi-background-tasks",
		"camoufox-js",
		"pi-code-previews",
		"pi-multiloop",
		"pi-schedule-prompt",
		"pi-skill-dollar",
		"pi-webaio",
		"typebox"
	]
}
