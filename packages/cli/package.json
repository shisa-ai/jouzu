{
	"name": "jouzu",
	"version": "0.1.19",
	"description": "Agentic AI environment built on the Pi coding agent harness",
	"type": "module",
	"bin": {
		"jouzu": "dist/cli.js",
		"jz": "dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/build-info.json",
		"README.md",
		"camoufox-runtime",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"build": "node ../../scripts/install-release-extensions.mjs && node ../../scripts/apply-task-flow.mjs && node ../../scripts/apply-code-previews.mjs && node ../../scripts/apply-pi-content-policy.mjs && node ../../scripts/apply-pi-path-utils.mjs && node ../../scripts/configure-release-packlists.mjs && tsc -p tsconfig.json && node ../../scripts/copy-session-ui.mjs && node ../../scripts/prepare-cli.mjs && node ../../scripts/copy-pi-lock.mjs dist/pi.lock.json && node ../../scripts/copy-profiles.mjs && node ../../scripts/copy-catalog.mjs && node ../../scripts/copy-release-extensions.mjs && node ../../scripts/build-textguard.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "node ../../scripts/check-dist-fresh.mjs && node ../../scripts/run-tests.mjs test/*.test.mjs"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"coding-agent",
		"pi",
		"japanese",
		"jouzu"
	],
	"author": "Shisa AI",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shisa-ai/jouzu.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/shisa-ai/jouzu#readme",
	"bugs": {
		"url": "https://github.com/shisa-ai/jouzu/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@napi-rs/canvas": "0.1.80",
		"@earendil-works/pi-ai": "1.0.0",
		"@earendil-works/pi-codemode": "1.0.0",
		"@earendil-works/pi-coding-agent": "1.0.0",
		"@earendil-works/pi-mcp": "1.0.0",
		"@earendil-works/pi-server": "1.0.0",
		"@earendil-works/pi-telemetry": "1.0.0",
		"@earendil-works/pi-tui": "1.0.0",
		"@lhl/pi-tasks": "git+https://github.com/lhl/pi-tasks.git#a07c749439b1909a95a974bf6ee8a560f6d2b0d9",
		"@picovoice/pvrecorder-node": "1.2.9",
		"@sting8k/pi-vcc": "0.7.2",
		"@vanillagreen/pi-background-tasks": "git+https://github.com/shisa-ai/kendex.git#66356512b81d2358b17531fffa791e2f1e51afef",
		"esbuild": "0.28.2",
		"pi-code-previews": "0.1.36",
		"pi-multiloop": "git+https://github.com/lhl/pi-multiloop.git#becca4ab47bf9953c66d96ecbac16bf2debe6881",
		"pi-schedule-prompt": "0.4.1",
		"pi-skill-dollar": "git+https://github.com/lhl/pi-skill-dollar.git#4bff5734d87c4f4725d81a4ea1d1c1283c22423c",
		"pi-webaio": "git+https://github.com/shisa-ai/pi-webaio.git#f65ae726bc95c50dc0e2c5a0ea95c2cdfb9a1bc2",
		"typebox": "1.3.27",
		"wreq-js": "3.2.0",
		"ws": "8.21.3",
		"@earendil-works/pi-agent-core": "1.0.0"
	},
	"bundleDependencies": [
		"@earendil-works/pi-ai",
		"@earendil-works/pi-codemode",
		"@earendil-works/pi-coding-agent",
		"@earendil-works/pi-mcp",
		"@earendil-works/pi-telemetry",
		"@earendil-works/pi-tui",
		"@lhl/pi-tasks",
		"@picovoice/pvrecorder-node",
		"ws",
		"@sting8k/pi-vcc",
		"@vanillagreen/pi-background-tasks",
		"pi-code-previews",
		"pi-multiloop",
		"pi-schedule-prompt",
		"pi-skill-dollar",
		"pi-webaio",
		"typebox",
		"@earendil-works/pi-agent-core"
	]
}
