{
	"name": "jouzu",
	"version": "0.1.4",
	"description": "Agentic AI environment built on the Pi coding agent harness",
	"type": "module",
	"bin": {
		"jouzu": "dist/cli.js",
		"jz": "dist/cli.js"
	},
	"files": [
		"dist",
		"!dist/build-info.json",
		"README.md",
		"LICENSE",
		"THIRD_PARTY_NOTICES.md"
	],
	"scripts": {
		"build": "node ../../scripts/install-release-extensions.mjs && tsc -p tsconfig.json && node ../../scripts/copy-session-ui.mjs && node ../../scripts/prepare-cli.mjs && node ../../scripts/copy-pi-lock.mjs dist/pi.lock.json && node ../../scripts/copy-profiles.mjs && node ../../scripts/copy-catalog.mjs && node ../../scripts/copy-release-extensions.mjs",
		"check": "tsc -p tsconfig.json --noEmit",
		"test": "node ../../scripts/check-dist-fresh.mjs && node --test test/*.test.mjs"
	},
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"coding-agent",
		"pi",
		"japanese",
		"jouzu"
	],
	"author": "Shisa AI",
	"license": "Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/shisa-ai/jouzu.git",
		"directory": "packages/cli"
	},
	"homepage": "https://github.com/shisa-ai/jouzu#readme",
	"bugs": {
		"url": "https://github.com/shisa-ai/jouzu/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"dependencies": {
		"@earendil-works/pi-coding-agent": "0.84.3",
		"@earendil-works/pi-tui": "0.84.3",
		"@lhl/pi-goal": "git+https://github.com/lhl/pi-goal.git#a38ff5f0aab12a4591d05845de4f0a16033530ca",
		"@lhl/pi-tasks": "git+https://github.com/lhl/pi-tasks.git#be52712d391d3b3771204222f203c4e06175d3da",
		"@sting8k/pi-vcc": "0.7.0",
		"@the-forge-flow/camoufox-pi": "0.2.1",
		"@vanillagreen/pi-background-tasks": "2.0.0",
		"better-sqlite3": "13.0.1",
		"camoufox-js": "0.12.0",
		"pi-code-previews": "0.1.36",
		"pi-multiloop": "git+https://github.com/lhl/pi-multiloop.git#491968d257a906f34a47f8bf77f065d6348666cc",
		"pi-schedule-prompt": "0.4.1",
		"pi-skill-dollar": "git+https://github.com/lhl/pi-skill-dollar.git#4bff5734d87c4f4725d81a4ea1d1c1283c22423c",
		"pi-smart-fetch": "0.3.17",
		"playwright-core": "1.60.0"
	},
	"overrides": {
		"@the-forge-flow/camoufox-pi": {
			"camoufox-js": "0.12.0",
			"playwright-core": "1.60.0"
		}
	},
	"bundleDependencies": [
		"@earendil-works/pi-coding-agent",
		"@earendil-works/pi-tui",
		"@lhl/pi-goal",
		"@lhl/pi-tasks",
		"@sting8k/pi-vcc",
		"@the-forge-flow/camoufox-pi",
		"@vanillagreen/pi-background-tasks",
		"better-sqlite3",
		"camoufox-js",
		"pi-code-previews",
		"pi-multiloop",
		"pi-schedule-prompt",
		"pi-skill-dollar",
		"pi-smart-fetch",
		"playwright-core"
	]
}
