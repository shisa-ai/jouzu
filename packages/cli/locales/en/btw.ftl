jouzu-cli-btw-description = Ask a side question without interrupting main work
jouzu-cli-btw-title = Side conversation
jouzu-cli-btw-contextUnavailable = Side context could not be checked. Reopen the session and try again.
jouzu-cli-btw-diverged = The main branch or model destination changed. Start a new side conversation.
jouzu-cli-btw-cancelled = Side request cancelled.
jouzu-cli-btw-question = Ask a question
jouzu-cli-btw-bring = Bring latest exchange to main editor
jouzu-cli-btw-steer = Send an instruction with this exchange as steering
jouzu-cli-btw-followUp = Send an instruction with this exchange as a follow-up
jouzu-cli-btw-stop = Cancel side request
jouzu-cli-btw-new = Start a new side conversation
jouzu-cli-btw-close = Close (keep side request running)
jouzu-cli-btw-empty = No side questions yet.
jouzu-cli-btw-busy = Answering side question… Main work continues.
jouzu-cli-btw-idle = Main work continues independently. Side answers are not sent to it.
jouzu-cli-btw-context = Reference: saved main conversation after content checks. Text only, at most 64,000 characters.
jouzu-cli-btw-noAnswer = No completed answer to bring to main yet.
jouzu-cli-btw-limit = This side conversation has 20 questions. Start a new one to continue.
jouzu-cli-btw-instruction = Enter the instruction for the main agent. The latest side exchange will be quoted as evidence.
jouzu-cli-btw-hintEdit = { $submit } send · { $cancel } actions
jouzu-cli-btw-hintBrowse = { $submit } choose · { $move } move · { $page } transcript · { $cancel } close
jouzu-cli-btw-hintCompact = { $submit } choose · { $move } move · { $cancel } close
jouzu-cli-btw-modeQuestion = Question
jouzu-cli-btw-modeInstruction = Main instruction
jouzu-cli-btw-delivery = Main input: { $state }{ $reason }
jouzu-cli-btw-retained = retained
jouzu-cli-btw-held = held
jouzu-cli-btw-queued = queued
jouzu-cli-btw-consumed = consumed
jouzu-cli-btw-rejected = rejected
jouzu-cli-btw-unknown = unknown
jouzu-cli-btw-nonInteractive = Side conversations use the interactive terminal. Run Jouzu without print or RPC mode, then use /btw.
jouzu-cli-helpOverlay-btw = { $command }{"  "}Side conversation
