{
	"$schema": "https://biomejs.dev/schemas/2.3.5/schema.json",
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.mjs",
			"scripts/**/*.mjs",
			"*.json",
			"packages/*/*.json",
			"upstream/*.json",
			"!package-lock.json",
			"!!**/node_modules",
			"!!**/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true
		}
	}
}
