{
	"$schema": "https://biomejs.dev/schemas/2.5.12/schema.json",
	"files": {
		"includes": [
			"packages/*/src/**/*.ts",
			"packages/*/test/**/*.mjs",
			"scripts/**/*.mjs",
			"*.json",
			"packages/*/*.json",
			"upstream/*.json",
			"upstream/pi-content-policy/flow-ingress.js",
			"!package-lock.json",
			"!!**/node_modules",
			"!!**/dist"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 120
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	}
}
